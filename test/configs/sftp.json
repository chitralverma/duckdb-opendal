{
  "description": "opendal common suite over sftp:// (atmoz/sftp emulator)",
  "init_script": "test/configs/auth_sftp.sql",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "opendal"
  ],
  "test_env": [
    {
      "env_name": "OPENDAL_BASE",
      "env_value": "sftp:///odfs"
    },
    {
      "env_name": "OPENDAL_EXTERNAL_BASE",
      "env_value": "sftp:///external"
    },
    {
      "env_name": "OPENDAL_SFTP_ENDPOINT",
      "env_value": "ssh://127.0.0.1:19400"
    },
    {
      "env_name": "OPENDAL_SFTP_USER",
      "env_value": "opendal"
    },
    {
      "env_name": "OPENDAL_SFTP_KEY",
      "env_value": "test/services/sftp/keys/id_ed25519"
    },
    {
      "env_name": "OPENDAL_SFTP_ROOT",
      "env_value": "/upload"
    }
  ]
}
