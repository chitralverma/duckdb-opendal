# Hadoop config for the hdfs-native tier. The image turns `<FILE>_<property>` keys
# into entries in that config file.
#
# Ports are pinned to this tier's range instead of the Hadoop defaults so the
# tiers can be brought up independently. The datanode ones matter: the namenode
# hands the client block locations pointing at `dfs.datanode.hostname` and the
# datanode's *advertised* port, so it has to be published under the same number.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=root
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.hostname=localhost
HDFS-SITE.XML_dfs.datanode.http.address=0.0.0.0:19412
HDFS-SITE.XML_dfs.datanode.address=0.0.0.0:19413
HDFS-SITE.XML_dfs.datanode.ipc.address=0.0.0.0:19414
